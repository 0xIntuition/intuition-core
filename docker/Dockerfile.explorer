# Build on Railway with the full Bun workspace as context.
FROM oven/bun:1.3.11 AS build
WORKDIR /repo
COPY . .
RUN bun install --frozen-lockfile
ARG VITE_API_URL
ARG VITE_ATOM_SEMANTIC_READS_ENABLED=false
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ATOM_SEMANTIC_READS_ENABLED=$VITE_ATOM_SEMANTIC_READS_ENABLED
RUN bun run --cwd apps/explorer build

FROM node:24.11.1-alpine AS runtime
WORKDIR /app
COPY --from=build --chown=node:node /repo/apps/explorer/.output ./.output
ENV NODE_ENV=production
ENV HOST=::
ENV NITRO_HOST=::
ENV PORT=3000
EXPOSE 3000
USER node
CMD ["node", ".output/server/index.mjs"]
