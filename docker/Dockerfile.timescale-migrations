# One-shot event-store migrations for TimescaleDB.
# Build context: repo root. Applies migrations/timescale/*.sql sequentially,
# tracked in a schema_migrations table so each file runs exactly once.

FROM postgres:16-alpine

ARG VERSION=dev
ARG VCS_REF=unknown
ARG CREATED=unknown
LABEL org.opencontainers.image.title="Intuition Core Timescale Migrations" \
      org.opencontainers.image.description="One-shot TimescaleDB event-store migrations for Intuition Core" \
      org.opencontainers.image.source="https://github.com/0xIntuition/intuition-core" \
      org.opencontainers.image.url="https://github.com/0xIntuition/intuition-core" \
      org.opencontainers.image.documentation="https://github.com/0xIntuition/intuition-core/tree/main/docs" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${CREATED}"

COPY migrations/timescale/ /migrations/

COPY docker/run-timescale-migrations.sh /run-migrations.sh

RUN chmod +x /run-migrations.sh

ENTRYPOINT ["/run-migrations.sh"]
